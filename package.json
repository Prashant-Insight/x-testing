{
  "name": "x-testing",
  "version": "1.0.0",
  "description": "Interactive end-to-end testing and security risk analysis dashboard.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "compile": "npm run build",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "security:audit": "npm audit --audit-level=moderate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prashant-Insight/x-testing.git"
  },
  "keywords": [
    "testing",
    "security",
    "dashboard",
    "playwright"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Prashant-Insight/x-testing/issues"
  },
  "homepage": "https://github.com/Prashant-Insight/x-testing#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "eslint": "^10.6.0",
    "vite": "^8.1.2"
  }
}
